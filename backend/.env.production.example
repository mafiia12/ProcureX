# Production (Render) environment variables - NAMES ONLY.
#
# Set real values in the Render dashboard (render.yaml marks secrets
# sync: false); never commit them. backend/.env.example is the local
# development template; this file lists what a hosted deployment needs.
# The app refuses to start in production when a required value is missing
# or unsafe (see _validate_hosted_configuration in server.py).
#
# Two services read this: the ERP API (APP_SURFACE=full) and the public
# request API (APP_SURFACE=public). Sections say which one needs what.

# ---------- Required: both services ----------
# APP_ENV must be "production": disables /docs and /openapi.json, enables
# HSTS and the hosted-configuration checks, hides local-only Settings actions.
APP_ENV=
# "full" (ERP API) or "public" (public request API)
APP_SURFACE=
# PostgreSQL connection string (postgresql://...?sslmode=require)
DATABASE_URL=
# Explicit HTTPS origin allowlist, comma-separated, no wildcards
CORS_ORIGINS=
# Explicit hostname allowlist, comma-separated, no scheme or wildcards
TRUSTED_HOSTS=
# Must be "true"
FORCE_HTTPS=
# Must be "s3" (Cloudflare R2)
ATTACHMENT_STORAGE_BACKEND=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=

# ---------- Required: ERP API (APP_SURFACE=full) ----------
# At least 32 random characters
AUTH_SECRET_KEY=
# Required whenever TRUST_PROXY_HEADERS=true
INTERNAL_REQUEST_TOKEN=

# ---------- Required: public request API (APP_SURFACE=public) ----------
# At least 32 random characters
REQUEST_PRIVACY_SALT=

# ---------- WhatsApp Business (Meta) ----------
# Public HTTPS base URL of the service Meta calls back to. Settings shows
# {PUBLIC_BASE_URL}/api/integrations/whatsapp/webhook as the webhook URL,
# or "not configured" when this is empty.
PUBLIC_BASE_URL=
WHATSAPP_ENABLED=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- Proxy / client IP ----------
TRUST_PROXY_HEADERS=
TRUSTED_PROXY_HOPS=

# ---------- Capacity tuning (optional; defaults apply when empty) ----------
WEB_CONCURRENCY=
DB_POOL_SIZE=
DB_POOL_MAX_OVERFLOW=
DB_POOL_TIMEOUT_SECONDS=
DB_POOL_RECYCLE_SECONDS=
DB_STATEMENT_TIMEOUT_MS=
DB_LOCK_TIMEOUT_MS=
# Seconds to wait for a new PostgreSQL connection (default 5; 0 = no limit)
DB_CONNECT_TIMEOUT_SECONDS=
ATTACHMENT_STORAGE_MAX_THREADS=
R2_CONNECT_TIMEOUT_SECONDS=
R2_READ_TIMEOUT_SECONDS=
R2_MAX_ATTEMPTS=
R2_MAX_POOL_CONNECTIONS=

# ---------- Auth tuning (optional) ----------
AUTH_TOKEN_EXPIRES_MINUTES=
AUTH_LOGIN_RATE_LIMIT=
AUTH_LOGIN_RATE_WINDOW_SECONDS=

# ---------- Public request limits (optional; public service) ----------
PUBLIC_REQUEST_RATE_LIMIT=
PUBLIC_REQUEST_RATE_WINDOW_SECONDS=
PUBLIC_MAX_UPLOAD_BYTES=
PUBLIC_MAX_TOTAL_UPLOAD_BYTES=
PUBLIC_MAX_REQUEST_ITEMS=
PUBLIC_MAX_HTTP_BODY_BYTES=

# ---------- Public approval page content (optional) ----------
PUBLIC_COMPANY_NAME=
INSTAPAY_RECEIVING_ACCOUNT=
VODAFONE_CASH_RECEIVING_ACCOUNT=

# ---------- Document extraction (optional) ----------
DOCUMENT_EXTRACTION_ENABLED=
DOCUMENT_WORKER_ENABLED=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
OPENAI_API_KEY=
OPENAI_DOCUMENT_EXTRACTION_MODEL=

# ---------- One-time: scripts/bootstrap_admin.py (unset afterwards) ----------
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Not used by the API (listed so nothing is missed) ----------
# Frontend static sites (build time): REACT_APP_BACKEND_URL,
#   REACT_APP_PUBLIC_API_URL, GENERATE_SOURCEMAP=false
# Nightly backup job (GitHub Actions secrets, see
#   .github/workflows/production-backup.yml): PRODUCTION_DATABASE_URL,
#   R2_BACKUP_ACCESS_KEY_ID, R2_BACKUP_SECRET_ACCESS_KEY, R2_ENDPOINT_URL,
#   R2_BACKUP_BUCKET

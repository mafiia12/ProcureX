APP_ENV=development
APP_SURFACE=full
DATABASE_URL=sqlite:///./procurement.db

# Process model. Local/desktop runs SQLite: keep ONE process (SQLite has a
# single writer, and the launcher supervises exactly one uvicorn). Uvicorn
# reads WEB_CONCURRENCY as its worker count; leave it unset or 1 here.
# Never run more than one worker without a fixed AUTH_SECRET_KEY - each
# process would otherwise sign tokens with its own random dev secret.
# WEB_CONCURRENCY=1

# PostgreSQL only (ignored for SQLite). Measured defaults - see
# docs/production-capacity-plan.md. Per process the most connections used is
# DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW; total = sum over every worker of every
# service sharing the database, and must stay under SHOW max_connections
# minus admin/migration/backup headroom.
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT_SECONDS=5
# DB_POOL_RECYCLE_SECONDS=1800
# Server-side bounds per statement (0 disables): a longer wait returns a
# retryable 503 instead of freezing the worker.
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_LOCK_TIMEOUT_MS=3000

# Required in staging/production - a strong, random, per-environment secret.
# There is no dev fallback outside APP_ENV=development/test; never commit a
# real value here.
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRES_MINUTES=720

# Login brute-force throttle: lock out after this many failed attempts
# (per hashed client IP AND per submitted username, whichever trips first)
# within the window below. The IP-keyed half only runs when
# TRUST_PROXY_HEADERS=true (see auth/router.py for why).
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=900

# CORS_ORIGINS/TRUSTED_HOSTS default to localhost for local development only.
# Before deploying, set these to the real production frontend origin(s)/host(s)
# - never leave them as localhost, and never use "*" for CORS_ORIGINS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FORCE_HTTPS=false
ATTACHMENT_STORAGE_BACKEND=local
INCOMING_REQUEST_UPLOAD_DIR=./storage/incoming_requests

# Optional production path overrides. If PROCUREX_DATA_ROOT is set, the
# database/attachments/backups/logs paths below are derived from it
# automatically; set the individual vars only to override further.
# PROCUREX_DATA_ROOT=
# PROCUREX_BACKUP_DIR=
# PROCUREX_LOG_DIR=

# Optional human-reviewed document extraction. Keep false until every required
# provider variable is configured; manual purchase-request entry remains available.
DOCUMENT_EXTRACTION_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
OPENAI_API_KEY=
OPENAI_DOCUMENT_EXTRACTION_MODEL=
OPENAI_API_BASE_URL=https://api.openai.com/v1
DOCUMENT_PROVIDER_TIMEOUT_SECONDS=120
DOCUMENT_MAX_FILE_BYTES=10485760
DOCUMENT_MAX_TOTAL_BYTES=31457280
DOCUMENT_MAX_FILES=10
DOCUMENT_PROCESSING_MAX_ATTEMPTS=3
DOCUMENT_WORKER_POLL_SECONDS=2
DOCUMENT_RETENTION_DAYS=90

# Historical construction schema compatibility only. The calculator, API, and
# automatic reference-data installation are unavailable in ProcureX 0.3.0.
CONSTRUCTION_API_ENABLED=false
CONSTRUCTION_AUTO_INSTALL=false

# WhatsApp purchase-request intake (Meta WhatsApp Business Cloud API). Once
# these are set, day-to-day on/off control moves to Settings -> WhatsApp
# Purchase Requests in the app (no restart needed) - WHATSAPP_ENABLED here is
# only the one-time initial value for that switch. Never commit real values.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# The externally-reachable base URL Meta calls back to. Settings shows the
# computed "{PUBLIC_BASE_URL}/api/integrations/whatsapp/webhook" as the exact
# URL to register in Meta; it deliberately never falls back to a local/
# localhost URL, since Meta cannot reach one. Leave empty until ProcureX is
# reachable over the internet somehow:
#   - permanent hosting:  PUBLIC_BASE_URL=https://procurex.<your-domain>
#   - local live-testing: PUBLIC_BASE_URL=https://<current-tunnel>.trycloudflare.com
#     (start_whatsapp_test.bat keeps this in sync automatically for that case)
PUBLIC_BASE_URL=

# Backend base URL (no trailing slash). Leave empty to auto-detect:
# the app uses the dev machine's LAN IP from Expo on port 8000.
#   Android emulator: http://10.0.2.2:8000
#   iOS simulator:    http://localhost:8000
#   Real device:      http://<your-PC-LAN-IP>:8000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT=10000

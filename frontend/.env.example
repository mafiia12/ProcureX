# These are inlined into the bundle at BUILD time (Create React App behavior).
# The 127.0.0.1 defaults below are for local development only - a production
# build MUST be run with both vars set to the real deployed backend origin,
# or the shipped bundle will silently try to reach the visitor's own machine.
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
REACT_APP_PUBLIC_API_URL=http://127.0.0.1:8000

# REACT_APP_BACKEND_URL is inlined into the bundle at BUILD time (Create React
# App behavior), so whatever you set here is shared by every device that
# loads this bundle - a loopback or LAN-IP value only works on the machine(s)
# it names.
#
# Leave it UNSET (the default) so the app calls the API via relative /api
# paths instead - the browser resolves these against whatever origin served
# the page, and src/setupProxy.js proxies /api to the local backend
# (http://127.0.0.1:8000) inside the dev server. This one build then works
# unchanged from http://localhost:3000, http://192.168.1.33:3000 (LAN), and a
# single Cloudflare quick tunnel pointed at the frontend
# (cloudflared tunnel --url http://127.0.0.1:3000) - the browser never needs
# to know the backend's address.
#
# Only set REACT_APP_BACKEND_URL if the frontend and backend are deliberately
# served from different origins (e.g. REACT_APP_BACKEND_URL=http://192.168.1.33:8000).
#REACT_APP_BACKEND_URL=

# Only used by the separate public-facing build (npm run build:public); leave
# unset for the internal LAN app.
REACT_APP_PUBLIC_API_URL=http://127.0.0.1:8000

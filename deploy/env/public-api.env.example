APP_ENV=production
APP_SURFACE=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Concurrency (see docs/production-capacity-plan.md). Uvicorn reads
# WEB_CONCURRENCY as its worker count. Keep 1: the public intake
# rate limiter and the WhatsApp webhook are only correct within one process.
WEB_CONCURRENCY=1
# Per worker: at most DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW connections. The
# public API and the ERP API share one database - size both together
# against SHOW max_connections.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
ATTACHMENT_STORAGE_BACKEND=s3
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-key
R2_BUCKET_NAME=procurex-private-attachments
R2_REGION=auto
CORS_ORIGINS=https://requests.example.com
TRUSTED_HOSTS=api-requests.example.com
FORCE_HTTPS=true
TRUST_PROXY_HEADERS=false
REQUEST_PRIVACY_SALT=replace-with-at-least-32-random-characters
PUBLIC_REQUEST_RATE_LIMIT=5
PUBLIC_REQUEST_RATE_WINDOW_SECONDS=900
PUBLIC_MAX_UPLOAD_BYTES=5242880
PUBLIC_MAX_TOTAL_UPLOAD_BYTES=26214400
PUBLIC_MAX_REQUEST_ITEMS=20
PUBLIC_MAX_HTTP_BODY_BYTES=28311552

# WhatsApp intake webhook. This service (not the ERP API) is Meta's
# registered callback target - see render.yaml's comment on procurex-erp-api
# for why. whatsapp_settings lives in the shared database, so the admin
# on/off toggle on the ERP app keeps working regardless.
PUBLIC_BASE_URL=https://api-requests.example.com
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

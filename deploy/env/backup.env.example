DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/DATABASE?sslmode=require
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=procurex-private-backups
AWS_ACCESS_KEY_ID=replace-with-backup-bucket-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-bucket-secret-key
AWS_DEFAULT_REGION=auto

APP_ENV=production
APP_SURFACE=full
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ATTACHMENT_STORAGE_BACKEND=s3
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-key
R2_BUCKET_NAME=procurex-private-attachments
R2_REGION=auto
CORS_ORIGINS=https://erp.example.com
TRUSTED_HOSTS=api-erp.example.com
FORCE_HTTPS=true
# Requires INTERNAL_REQUEST_TOKEN below - _validate_hosted_configuration
# refuses to start otherwise, since without a real token the internal-access
# gate's "trust localhost" fallback would be spoofable from the internet
# behind the reverse proxy.
TRUST_PROXY_HEADERS=true
INTERNAL_REQUEST_TOKEN=replace-with-a-long-random-shared-token

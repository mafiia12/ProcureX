APP_ENV=production
APP_SURFACE=full
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Concurrency (see docs/production-capacity-plan.md). Uvicorn reads
# WEB_CONCURRENCY as its worker count. 2 measured ~2x throughput and
# isolates one slow request from other users.
WEB_CONCURRENCY=2
# Per worker: at most DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW connections. The
# public API and the ERP API share one database - size both together
# against SHOW max_connections.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
ATTACHMENT_STORAGE_BACKEND=s3
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-key
R2_BUCKET_NAME=procurex-private-attachments
R2_REGION=auto
CORS_ORIGINS=https://erp.example.com
TRUSTED_HOSTS=api-erp.example.com
FORCE_HTTPS=true
# Temporarily false until Render's actual proxy-to-container hop address is
# verified - see render.yaml's comment on this service. The IP-keyed login
# limiter self-disables whenever this is not exactly "true"; the
# username-keyed limiter stays fully active regardless. If this is ever set
# to "true", INTERNAL_REQUEST_TOKEN below becomes mandatory -
# _validate_hosted_configuration refuses to start without it, since without
# a real token the internal-access gate's "trust localhost" fallback would
# be spoofable from the internet behind the reverse proxy.
TRUST_PROXY_HEADERS=false
INTERNAL_REQUEST_TOKEN=replace-with-a-long-random-shared-token

# WhatsApp: duplicated from the public API's env, not a duplicate settings
# store. whatsapp_admin_router (Settings, Test Connection) is mounted only
# on this full surface and calls Meta's API directly to verify
# connectivity, so it needs its own copy of these same Meta credentials.
# The public API remains Meta's one registered webhook target; the on/off
# toggle and connection status still live in the single shared
# whatsapp_settings row in Postgres, not here.
PUBLIC_BASE_URL=https://api-requests.example.com
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

APP_ENV=production
APP_SURFACE=public
RELEASE_GATE_PASSED=true
RELEASE_COMMIT_SHA=replace-with-tested-commit-sha
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=procurex-private-backups
R2_BACKUP_ACCESS_KEY_ID=replace-with-backup-bucket-access-key
R2_BACKUP_SECRET_ACCESS_KEY=replace-with-backup-bucket-secret-key
R2_REGION=auto

APP_ENV=staging
APP_SURFACE=public
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/STAGING_DATABASE?sslmode=require

# Concurrency (see docs/production-capacity-plan.md). Uvicorn reads
# WEB_CONCURRENCY as its worker count. Keep 1: the public intake
# rate limiter and the WhatsApp webhook are only correct within one process.
WEB_CONCURRENCY=1
# Per worker: at most DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW connections. The
# public API and the ERP API share one database - size both together
# against SHOW max_connections.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
ATTACHMENT_STORAGE_BACKEND=s3
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-staging-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=replace-with-staging-bucket-scoped-secret-key
R2_BUCKET_NAME=procurex-staging-private-attachments
R2_REGION=auto
CORS_ORIGINS=https://requests-staging.example.com
TRUSTED_HOSTS=api-requests-staging.example.com
FORCE_HTTPS=true
TRUST_PROXY_HEADERS=false
# When TRUST_PROXY_HEADERS=true: how many X-Forwarded-For entries (from the
# right) your own proxies append. The client address is the entry at that
# position; anything further left is client-supplied and ignored.
TRUSTED_PROXY_HOPS=1
REQUEST_PRIVACY_SALT=replace-with-a-distinct-staging-value-of-at-least-32-characters
PUBLIC_REQUEST_RATE_LIMIT=10
PUBLIC_REQUEST_RATE_WINDOW_SECONDS=900
PUBLIC_MAX_UPLOAD_BYTES=5242880
PUBLIC_MAX_TOTAL_UPLOAD_BYTES=26214400
PUBLIC_MAX_REQUEST_ITEMS=20
PUBLIC_MAX_HTTP_BODY_BYTES=28311552

# WhatsApp intake webhook. This service (not the staging ERP API) is Meta's
# registered callback target for the staging Meta app/number - see
# render.staging.yaml's comment on procurex-staging-erp-api for why.
PUBLIC_BASE_URL=https://requests-staging.example.com
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=replace-with-staging-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-staging-meta-access-token
WHATSAPP_VERIFY_TOKEN=replace-with-a-distinct-staging-verify-token
WHATSAPP_APP_SECRET=replace-with-staging-meta-app-secret

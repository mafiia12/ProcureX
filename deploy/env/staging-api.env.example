APP_ENV=staging
APP_SURFACE=public
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/STAGING_DATABASE?sslmode=require
ATTACHMENT_STORAGE_BACKEND=s3
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-staging-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=replace-with-staging-bucket-scoped-secret-key
R2_BUCKET_NAME=procurex-staging-private-attachments
R2_REGION=auto
CORS_ORIGINS=https://requests-staging.example.com
TRUSTED_HOSTS=api-requests-staging.example.com
FORCE_HTTPS=true
TRUST_PROXY_HEADERS=false
REQUEST_PRIVACY_SALT=replace-with-a-distinct-staging-value-of-at-least-32-characters
PUBLIC_REQUEST_RATE_LIMIT=10
PUBLIC_REQUEST_RATE_WINDOW_SECONDS=900
PUBLIC_MAX_UPLOAD_BYTES=5242880
PUBLIC_MAX_TOTAL_UPLOAD_BYTES=26214400
PUBLIC_MAX_REQUEST_ITEMS=20
PUBLIC_MAX_HTTP_BODY_BYTES=28311552
